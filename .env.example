# Frontend environment for local development or Vercel
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
DATABASE_URL=

# Optional: Goodreads scraper credentials. Keep real values only in local .env.
GOODREADS_BASE_URL=https://www.goodreads.com/
GOODREADS_EMAIL=
GOODREADS_PASSWORD=
GOODREADS_GENRES=fiction,fantasy,science fiction,mystery,thriller,horror,romance,historical fiction,young adult,biography,history,science
# Set to 0 to keep crawling until Goodreads stops returning pages.
GOODREADS_MAX_PAGES=0
GOODREADS_OUTPUT=data/goodreads_books.json
GOODREADS_CHECKPOINT=data/goodreads.checkpoint.json
# Set true to visit each book page for exact "First published" dates. This is much slower.
GOODREADS_ENRICH_DETAILS=false

# The app is Supabase-first, but the admin dashboard's account
# create/delete + last-login features require the server (they need the
# Supabase service-role key below, which the browser must never see).
# Keep this true if you want admin account management to work.
REACT_APP_ENABLE_LEGACY_BACKEND=true

# Optional: Developer Lab can prefer a DB-backed /api/dev-lab backend.
# REACT_APP_DEVLAB_API_MODE=auto
# REACT_APP_DEVLAB_API_URL=

# Optional: Chatbot can prefer the Supabase edge function or the server /api/chat backend.
# REACT_APP_CHATBOT_API_MODE=auto
# REACT_APP_CHATBOT_API_URL=
# REACT_APP_CHATBOT_FUNCTION_NAME=ai-chatbot

# Optional: Trakt powers movie/TV relevance sorting and featured picks.
# Keep the secret server-side only; public Trakt chart endpoints use the client ID.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# OMDb (free key: omdbapi.com/apikey.aspx, 1,000 requests/day): IMDb, Rotten
# Tomatoes and Metacritic scores on title pages/cards, and IMDb episode
# ratings in the episode heatmap (server/routes/extras.js, cached in Supabase).
# Without it the site falls back to TMDB ratings. Server-side only.
OMDB_API_KEY=
# Subtitles for the TV app (free key at https://www.opensubtitles.com/en/consumers).
# Username/password (a free opensubtitles.com account) raise the daily download limit.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Groq (free key: console.groq.com): "Ask binge." natural-language search
# (POST /api/extras/ai/picks). Server-side only.
GROQ_API_KEY=

# Required for the admin dashboard's "create account" / "delete account"
# buttons — Supabase project settings → API → service_role key.
# Server-side only. Never prefix this with REACT_APP_ or it ships to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function secrets (legacy ai-chatbot function).
# Set these with `supabase secrets set ...` for deployed functions.
# TAVILY_API_KEY=
# TMDB_API_KEY=
# SUPABASE_DB_URL=

# Optional: only set this if you intentionally still run the legacy backend.
# REACT_APP_LEGACY_API_URL=

# Optional: Google Books API key for book previews (server-side; free in Google Cloud console)
GOOGLE_BOOKS_API_KEY=

# Web push (new-episode alerts). Generate with: npx web-push generate-vapid-keys
REACT_APP_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=

# ── Monitoring ──────────────────────────────────────────────────────────
# Errors are logged to binge.'s own Supabase table (admin panel → Errors);
# no third-party tracker or key needed.
# Optional Discord/Slack incoming-webhook URL for streaming-server outage
# alerts (admins also get a push notification).
ALERT_WEBHOOK_URL=

# ── End-to-end tests (npm run test:e2e) ─────────────────────────────────
# A dedicated TEST account — never your real one; the tests rate/clean up.
E2E_EMAIL=
E2E_PASSWORD=
# Run against a deployment instead of starting the app locally:
# E2E_BASE_URL=https://your-site.vercel.app
