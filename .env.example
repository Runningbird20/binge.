# PostgreSQL Backend Configuration
DATA_BACKEND=standalone
REACT_APP_DATA_BACKEND=standalone

# Local Postgres (started by 'npm run db:start') or Neon/hosted Postgres
DATABASE_URL=postgresql://cristalwilliams@127.0.0.1:55440/postgres

# Media catalog API keys
REACT_APP_TMDB_API_KEY=
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Optional: Trakt powers movie/TV relevance sorting and featured picks.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Optional: OMDb enriches movie relevance with Rotten Tomatoes-style ratings.
OMDB_API_KEY=

# Optional: AI Chatbot API keys
# GROQ_API_KEY=
# TAVILY_API_KEY=

# Optional: Goodreads scraper credentials.
GOODREADS_BASE_URL=https://www.goodreads.com/
GOODREADS_EMAIL=
GOODREADS_PASSWORD=
GOODREADS_GENRES=fiction,fantasy,science fiction,mystery,thriller,horror,romance,historical fiction,young adult,biography,history,science
GOODREADS_MAX_PAGES=0
GOODREADS_OUTPUT=data/goodreads_books.json
GOODREADS_CHECKPOINT=data/goodreads.checkpoint.json
GOODREADS_ENRICH_DETAILS=false
