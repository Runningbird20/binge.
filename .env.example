# Frontend environment for local development or Vercel
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
DATABASE_URL=

# Keep this false for the Supabase-first app.
REACT_APP_ENABLE_LEGACY_BACKEND=false

# Optional: Developer Lab can prefer a DB-backed /api/dev-lab backend.
# REACT_APP_DEVLAB_API_MODE=auto
# REACT_APP_DEVLAB_API_URL=

# Optional: only set this if you intentionally still run the legacy backend.
# REACT_APP_LEGACY_API_URL=
