# Test-only environment overrides (safe to commit — no secrets).
# Loaded automatically by `react-scripts test` (NODE_ENV=test) and takes
# precedence over .env, without touching real local/production config.
#
# api.test.js exercises requestLegacyApi()'s error-handling paths, which
# require LEGACY_BASE to resolve to a same-origin '/api' base — that only
# happens when this flag is true. Local .env may have it set to false for
# day-to-day dev; that's a separate concern from what the test suite needs.
REACT_APP_ENABLE_LEGACY_BACKEND=true
