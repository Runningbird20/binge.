{
  "name": "project-3",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "playwright": "^1.59.1",
    "py": "^0.0.0",
    "python": "^0.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "react-scripts": "5.0.1",
    "supabase": "^2.90.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "start": "concurrently \"npm run start:client\" \"npm run server\"",
    "start:client": "react-scripts start",
    "server": "node server/index.js",
    "dev": "npm start",
    "import:books": "node internet_archive_scraper.js --limit 25",
    "import:books:bulk": "node internet_archive_scraper.js --all --page-size 100 --max-pages 10",
    "import:books:resume": "node internet_archive_scraper.js --all --resume --page-size 100 --max-pages 10",
    "import:books:runner": "node internet_archive_resume_runner.js",
    "import:movies": "node plex_importer.js --type movie --limit 25",
    "import:movies:bulk": "node plex_importer.js --type movie --all --max-items 100",
    "import:movies:resume": "node plex_importer.js --type movie --all --resume --max-items 100",
    "import:movies:runner": "node plex_resume_runner.js --type movie",
    "import:tv": "node plex_importer.js --type tv --limit 25",
    "import:tv:bulk": "node plex_importer.js --type tv --all --max-items 100",
    "import:tv:resume": "node plex_importer.js --type tv --all --resume --max-items 100",
    "import:tv:runner": "node plex_resume_runner.js --type tv",
    "import:plex": "node plex_importer.js --type both --limit 25",
    "import:plex:bulk": "node plex_importer.js --type both --all --max-items 100",
    "import:plex:resume": "node plex_importer.js --type both --all --resume --max-items 100",
    "generate:supabase:movies": "node scripts/generate-supabase-movie-seed.js",
    "generate:supabase:tv": "node scripts/generate-supabase-tv-seed.js",
    "generate:supabase:books": "node scripts/generate-supabase-book-seed.js",
    "generate:supabase:catalogs": "npm run generate:supabase:movies && npm run generate:supabase:tv && npm run generate:supabase:books",
    "prepare:supabase:chunks": "node scripts/prepare-non-destructive-chunks.js",
    "supabase:sql": "node scripts/run-supabase-sql.js",
    "supabase:seed:catalogs": "node scripts/run-supabase-sql.js supabase/repeatable_schema.sql supabase/repeatable_movies_seed.sql supabase/repeatable_tv_shows_seed.sql supabase/repeatable_books_seed.sql",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "import:tmdb": "node tmdb_scraper.js --type both --pages 20",
    "import:tmdb:movies": "node tmdb_scraper.js --type movie --pages 20",
    "import:tmdb:tv": "node tmdb_scraper.js --type tv --pages 20",
    "import:tmdb:large": "node tmdb_scraper.js --type both --pages 100",
    "import:tmdb:resume": "node tmdb_scraper.js --type both --pages 500 --resume",
    "import:openlibrary": "node openlibrary_scraper.js --pages 5",
    "import:openlibrary:large": "node openlibrary_scraper.js --pages 20",
    "import:openlibrary:resume": "node openlibrary_scraper.js --pages 20 --resume",
    "import:tmdb:max": "node tmdb_scraper.js --type both --pages 500",
    "clean:adult": "node clean_adult_content.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
