{
  "name": "project-3",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:5001",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "react-scripts": "5.0.1",
    "sonner": "^2.0.8",
    "web-push": "^3.6.7"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "prestart": "node scripts/check-branch.js",
    "start": "concurrently \"npm run start:client\" \"npm run server\"",
    "start:client": "react-scripts start",
    "server": "node --watch --watch-preserve-output server/index.js",
    "dev": "npm start",
    "import:backfill-catalog": "node scripts/backfill-catalog-fields.js",
    "supabase:sql": "node scripts/run-supabase-sql.js",
    "check:sandbox": "node scripts/check-sandbox.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:server": "node --test \"server/**/*.test.js\"",
    "lint": "eslint --max-warnings=0 server api scripts src e2e",
    "eject": "react-scripts eject",
    "import:language": "node scripts/sync-language-to-turso.js",
    "import:language:preview": "node scripts/sync-language-to-turso.js --dry-run",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report e2e-report"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "overrides": [
      {
        "files": [
          "src/**/*.js"
        ],
        "extends": [
          "react-app/jest"
        ]
      },
      {
        "files": [
          "server/**/*.js",
          "api/**/*.js",
          "scripts/**/*.js"
        ],
        "parserOptions": {
          "sourceType": "script"
        },
        "rules": {
          "strict": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "concurrently": "^9.2.5",
    "patch-package": "^8.0.1"
  }
}
