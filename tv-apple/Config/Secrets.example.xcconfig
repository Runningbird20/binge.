// Copy to Secrets.xcconfig, or run scripts/make-secrets.sh to build it from
// ../.env. xcconfig treats "//" as a comment, so URLs are written with $().
// All three keys are the same public ones the website ships to browsers.
BINGE_SUPABASE_URL = https:/$()/your-project.supabase.co
BINGE_SUPABASE_KEY = sb_publishable_xxx
BINGE_TMDB_KEY = your-tmdb-v3-key
BINGE_SITE_URL = https:/$()/binge-26.vercel.app
