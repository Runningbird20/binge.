exports[`a server playing a different-length video is replaced 1`] = `"CineSrc was playing a different video, so we switched to VidRift.Try CineSrc anyway"`;

exports[`a server that never reports playback fails over to the next one 1`] = `"CineSrc couldn't play this episode, so we switched to VidRift.Try CineSrc anyway"`;

exports[`buffering offers a switch, then switches on its own: offer 1`] = `"Buffering on CineSrc…Switch to VidRift at 1:40"`;

exports[`buffering offers a switch, then switches on its own: switched 1`] = `"CineSrc kept buffering, so we switched to VidRift at 1:40.Try CineSrc anyway"`;

