exports[`Up Next appears near the end and plays the next episode after the countdown 1`] = `"<div class=\\"st-upnext\\" role=\\"dialog\\" aria-label=\\"Up next\\"><div class=\\"st-upnext-body\\"><strong>The Next One</strong><span class=\\"st-upnext-meta\\">Next: season 1, episode 2</span><div class=\\"st-upnext-actions\\"><button type=\\"button\\" class=\\"st-btn st-btn--primary\\"><svg xmlns=\\"http://www.w3.org/2000/svg\\" width=\\"16\\" height=\\"16\\" fill=\\"currentColor\\" viewBox=\\"0 0 256 256\\"><path d=\\"M240,128a15.74,15.74,0,0,1-7.6,13.51L88.32,229.65a16,16,0,0,1-16.2.3A15.86,15.86,0,0,1,64,216.13V39.87a15.86,15.86,0,0,1,8.12-13.82,16,16,0,0,1,16.2.3L232.4,114.49A15.74,15.74,0,0,1,240,128Z\\"></path></svg> Play now (10)</button><button type=\\"button\\" class=\\"st-btn st-btn--ghost\\">Cancel</button></div></div><span class=\\"st-upnext-bar\\" style=\\"animation-duration: 10s;\\" aria-hidden=\\"true\\"></span></div>"`;

